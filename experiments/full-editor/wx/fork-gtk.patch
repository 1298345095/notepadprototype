+FontMetrics SurfaceImpl::Metrics(const Font *font) noexcept {
+	if (!PFont(font)->fd)
+		return {1, 0, 0, 1};
+	UniquePangoFontMetrics metrics(pango_context_get_metrics(pcontext.get(), PFont(font)->fd.get(), language));
+	const auto ascent = std::max(1.0, std::ceil(pango_units_to_double(pango_font_metrics_get_ascent(metrics.get()))));
